[Unit]
Description=RGB Daemon (effect engine)
After=network.target openrgb-server.service
Requires=openrgb-server.service

[Service]
Type=simple
User=x81k25
WorkingDirectory=/infra/experiments/rgb
ExecStart=/home/x81k25/.local/bin/uv run python daemon.py
Restart=on-failure
RestartSec=5
Environment=HOME=/home/x81k25

[Install]
WantedBy=multi-user.target
